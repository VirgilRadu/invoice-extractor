# Variabilele celorlalti provideri sunt listate la inceputul fisierului src/lib/llm.ts
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Rezerva (withFallbacks): raspunde cand principalul pica dupa reincercari; fara LLM_FALLBACK_PROVIDER nu exista rezerva
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
